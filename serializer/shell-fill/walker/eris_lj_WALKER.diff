+/* One recipe, k of n: the per-recipe body of the original descending-id
+ * loop, unchanged (tests assert on these messages). Marks the shell filled
+ * before the call; refuses loudly on any deviation. */
+static void elj_fill_one(Info *I, int k, int n)
+{
+  lua_State *L = I->L;
+  int shell, ofs;
+  luaL_checkstack(L, 8, "eris-lj fill");
