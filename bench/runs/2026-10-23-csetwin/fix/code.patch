+local function nloop(body)
+  return "local O, BO, S = ..." .. NL .. "local k = 0" .. NL .. "for rep = 1, 13 do" .. NL ..
+    "  for n = 32, 63 do" .. NL .. "    local b = string.byte(S, n - 31)" .. NL .. body .. NL ..
