+local function nb(k) local n = 32 + (k - 1) % 32; return S6:byte(n - 31), n end
+-- body(a, c): the producer a first, then our operator c.
+local function ac(a, c)
+  return "  local a = " .. a .. "; local c = " .. c .. NL .. "  k = k + 1; BO[k] = a; O[k] = c"
