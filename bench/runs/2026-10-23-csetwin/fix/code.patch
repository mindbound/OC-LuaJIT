+      elseif C.need == "side" then
+        ok = ok and inorder(C.src, { "if i > 300 then", "local b = string.byte(S, i)", "local a = bit.lshift(b, 30)",
+          "local c = b << 30", "else" })
+      end
+      if C.need then ok = ok and count(C.src, "bit.") == 1 and count(C.src, "<<") == 1 end
